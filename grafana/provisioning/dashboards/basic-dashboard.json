{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Total Visitors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "text": {},
        "textMode": "auto"
      },
      "targets": [
        { "expr": "sum(http_server_requests_seconds_count)", "refId": "A" }
      ]
    },
    {
      "title": "Total Orders Placed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "quickbite_orders_created_total", "refId": "A" }
      ]
    },
    {
      "title": "Profit",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "quickbite_orders_created_total * 10", "refId": "A" }
      ]
    },
    {
      "title": "Revenue This Year vs Last Year",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "vector(894000)", "legendFormat": "This Year", "refId": "A" },
        { "expr": "vector(761000)", "legendFormat": "Last Year", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" }
      }
    },
    {
      "title": "Revenue - Achieved Target",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1000000, "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 600000 },
              { "color": "green", "value": 850000 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "vector(894000)", "refId": "A" }
      ]
    },
    {
      "title": "New Visitors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(http_server_requests_seconds_count) * 0.1", "refId": "A" }
      ]
    },
    {
      "title": "Unique Visitors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(http_server_requests_seconds_count) * 0.2", "refId": "A" }
      ]
    },
    {
      "title": "Traffic By Browser",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 4, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "vector(52)", "legendFormat": "Safari", "refId": "A" },
        { "expr": "vector(74)", "legendFormat": "Chrome", "refId": "B" },
        { "expr": "vector(32)", "legendFormat": "Firefox", "refId": "C" },
        { "expr": "vector(13)", "legendFormat": "IE", "refId": "D" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      }
    },
    {
      "title": "Sales Percentage by Categories",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "vector(15)", "legendFormat": "Marketing", "refId": "A" },
        { "expr": "vector(30)", "legendFormat": "Online", "refId": "B" },
        { "expr": "vector(9)", "legendFormat": "Sales", "refId": "C" },
        { "expr": "vector(45)", "legendFormat": "Stores", "refId": "D" }
      ]
    },
    {
      "title": "Avg Session Duration",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "m" }
      },
      "targets": [
        { "expr": "vector(7.5)", "refId": "A" }
      ]
    },
    {
      "title": "Avg Order Value per User",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" }
      },
      "targets": [
        { "expr": "vector(16)", "refId": "A" }
      ]
    },
    {
      "title": "Orders Trend (This Year vs Last Year)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 4, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(irate(http_server_requests_seconds_count[5m])) * 100", "legendFormat": "This Year", "refId": "A" },
        { "expr": "sum(irate(http_server_requests_seconds_count[5m])) * 80", "legendFormat": "Last Year", "refId": "B" }
      ]
    },
    {
      "title": "Server Resource: CPU Usage",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      },
      "targets": [
        { "expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A" }
      ]
    },
    {
      "title": "Server Resource: RAM Usage",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      },
      "targets": [
        { "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100", "refId": "A" }
      ]
    },
    {
      "title": "Server Resource: Disk Usage",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      },
      "targets": [
        { "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\"} * 100) / node_filesystem_size_bytes{mountpoint=\"/\"})", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["quickbite", "business-intelligence"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Business Intelligence & Server Metrics",
  "uid": "quickbite-bi-dashboard",
  "version": 1,
  "weekStart": ""
}
